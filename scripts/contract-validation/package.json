{
  "name": "@penatika/contract-validation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint:openapi": "redocly lint ../../contracts/openapi/openapi.yaml --config redocly.yaml",
    "bundle:openapi": "node scripts/prepare-temp.mjs && redocly bundle ../../contracts/openapi/openapi.yaml --dereferenced --output .tmp/openapi.dereferenced.json --config redocly.yaml",
    "test:schemas": "node --test test/schema-validation.test.mjs",
    "test:generator": "node scripts/generate-transports.mjs --check",
    "generate:transports": "npm run bundle:openapi && node scripts/generate-transports.mjs --write",
    "test": "npm run lint:openapi && npm run bundle:openapi && npm run test:schemas && npm run test:generator"
  },
  "devDependencies": {
    "@redocly/cli": "2.51.2",
    "ajv": "8.17.1",
    "openapi-typescript": "7.13.0"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
